# Telegram Bot Configuration
# Get your bot token from BotFather on Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Secret token to verify webhook requests (recommended for security)
BOT_SECRET=
# Webhook URL for Telegram (used by set:webhook and clear:updates scripts)
WEBHOOK_URL=https://your-domain.vercel.app/api
# Telegram Bot Allowlist Chat IDs (comma-separated for multiple)
TELEGRAM_BOT_ALLOWLIST=123456789
# Set your own Telegram ID before adding testers. Keeps your existing FILE_PATH;
# other users get separate users/<telegram-id>.md files in the same repository.
BOT_OWNER_ID=

# Storage Provider Configuration: github (default) | notion
STORAGE_PROVIDER=github

# GitHub Storage Configuration (Required if STORAGE_PROVIDER=github)
# GitHub Token for accessing GitHub API
PROVIDER_API_KEY=github_pat_YOUR_TOKEN_HERE
# Path to the tasks file in the GitHub repository
# Format: https://github.com/owner/repo/blob/branch/path/to/file.md
FILE_PATH=https://github.com/your-username/your-repo/blob/main/task-table.md

# Notion Storage Configuration (Required if STORAGE_PROVIDER=notion)
# Notion Internal Connection Token (starts with ntn_ or secret_)
NOTION_TOKEN=ntn_your_notion_token_here
# 32-character Database ID or database URL
NOTION_DATABASE_ID=your_32_char_database_id_here

# Google Calendar API Configuration (Optional)
# For Development: Use file path
GOOGLE_CALENDAR_CREDENTIALS_PATH=./google-api-credentials.json
# For Production: Use individual env vars
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PROJECT_ID=
# Calendar ID (Required for both dev and prod)
GOOGLE_CALENDAR_ID=your-email@gmail.com

# AI Provider: gemini | openai (also works with Groq, Together, Ollama) | anthropic
AI_PROVIDER=openai
# Model name; set explicitly for the selected provider
AI_MODEL=gpt-4.1-mini

# Gemini API Key (required if AI_PROVIDER=gemini)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=
# Optional: set base URL for non-OpenAI providers (Groq, Together, Ollama, etc.)
OPENAI_BASE_URL=

# Anthropic API Key (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Cron Secret (Test values)
CRON_SECRET=your_random_cron_secret_here

# GitHub Webhook Secret (for receiving push notifications)
# Generate a random string and use the same value when configuring the webhook in GitHub
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# Local speech recognition (polling server with Python), or gemini
VOICE_TRANSCRIPTION_PROVIDER=local
# Optional Python executable path; defaults to the project's .venv if installed
WHISPER_PYTHON=
WHISPER_MODEL=small
# Blank means detect the language automatically; use ru for Russian only
WHISPER_LANGUAGE=

# Optional tone instructions for the conversational assistant (one line)
ASSISTANT_STYLE=
# History defaults to runtime/assistant-history.json, kept out of Git
ASSISTANT_HISTORY_PATH=

# Optional Fire TV local ADB integration. Install Android Platform Tools on the bot server.
# Leave FIRE_TV_ADB_PATH as adb if adb is in PATH; otherwise set the full path to adb.exe.
FIRE_TV_ADB_PATH=adb
