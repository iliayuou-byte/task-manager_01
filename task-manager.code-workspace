{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.venv": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/bun.lock": true
    }
  },
  "extensions": {
    "recommendations": [
      "biomejs.biome"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Проверить формат и lint",
        "type": "shell",
        "command": "bun run lint",
        "problemMatcher": []
      },
      {
        "label": "Проверить TypeScript",
        "type": "shell",
        "command": "bun run build",
        "problemMatcher": []
      },
      {
        "label": "Запустить все тесты",
        "type": "shell",
        "command": "bun test",
        "problemMatcher": []
      },
      {
        "label": "Запустить один тестовый файл",
        "type": "shell",
        "command": "bun test ${input:testFile}",
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "testFile",
        "type": "promptString",
        "description": "Путь к тесту, например src/commands/menu.test.ts",
        "default": "src/commands/menu.test.ts"
      }
    ]
  }
}
