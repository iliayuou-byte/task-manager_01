{
  "name": "md-task-manager",
  "version": "1.15.1",
  "description": "Telegram bot that manages tasks in a Markdown file with AI parsing, Google Calendar sync, and GitHub storage",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prebuild": "bun src/scripts/generateChangelog.ts",
    "build": "tsc --noEmit",
    "prestart:polling": "bun src/scripts/generateChangelog.ts",
    "start:polling": "bun --env-file=.env src/polling.ts",
    "start": "bun --env-file=.env src/app.ts",
    "predev": "bun src/scripts/generateChangelog.ts",
    "dev": "bun --watch --env-file=.env src/dev.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "set:webhook": "bun --env-file=.env src/scripts/tg/setWebhook.ts",
    "get:webhook": "bun --env-file=.env src/scripts/tg/getWebhookInfo.ts",
    "clear:updates": "bun --env-file=.env src/scripts/tg/clearUpdate.ts"
  },
  "keywords": [
    "telegram-bot",
    "task-manager",
    "markdown",
    "google-calendar",
    "grammy"
  ],
  "author": "@klhq",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/klhq/md-task-manager"
  },
  "bugs": {
    "url": "https://github.com/klhq/md-task-manager/issues"
  },
  "homepage": "https://github.com/klhq/md-task-manager#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "@googleapis/calendar": "^14.2.0",
    "@grammyjs/auto-chat-action": "^0.1.1",
    "@hono/node-server": "^1.19.11",
    "@octokit/rest": "^22.0.1",
    "ai": "^6.0.185",
    "date-fns-tz": "^3.2.0",
    "google-auth-library": "^10.5.0",
    "grammy": "^1.41.1",
    "hono": "^4.12.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^24.10.7",
    "bun-types": "latest",
    "typescript": "5.4.5"
  }
}
